{
  "name": "vectra-sample-app",
  "version": "1.0.0",
  "description": "Intentionally imperfect Express application — VECTRA demo target",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest --json --outputFile=jest-results.json || true",
    "test:verbose": "jest --verbose",
    "test:ci": "jest --json"
  },
  "dependencies": {
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverage": false
  }
}
